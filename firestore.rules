rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Helper for Report validation
    function isValidReport(data) {
      return data.reporterEmail is string && data.reporterEmail.size() <= 200
          && data.asnInstansi is string && data.asnInstansi.size() <= 200
          && data.status in ['Pending', 'Ditinjau', 'Selesai', 'Ditolak']
          && data.location.lat is number
          && data.location.lng is number
          && data.asnName is string
          && data.description is string && data.description.size() <= 5000;
    }

    match /reports/{reportId} {
      // Anyone can create a report if valid
      allow create: if isValidReport(incoming())
                   && incoming().status == 'Pending'
                   && incoming().createdAt == request.time;
      
      // Public can read their own report if they have the ID (implicitly by knowing reportId)
      // We don't have secondary auth here, so we allow 'get' by ID.
      // But we prevent listing the whole collection to everyone.
      allow get: if true;
      
      // Update is restricted - usually only admins would update, 
      // but if we had a field like 'email' we could verify.
      // For this demo, we'll assume updates happen via backend or specified admin.
      allow update: if false; // Future: add admin check
    }

    match /test/connection {
      allow read: if true;
    }
  }
}
